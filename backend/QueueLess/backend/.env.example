DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
SECRET_KEY=supersecretkey
USE_FIREBASE_DATABASE=true
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_UPLOAD_ENABLED=false

# Firebase OTP token expiry in minutes after successful Firebase verification.
OTP_TOKEN_EXPIRE_MINUTES=15

# PostgreSQL startup flags are ignored when USE_FIREBASE_DATABASE=true.
# Allow the API to boot even when the database is unreachable during local development.
DB_INIT_ON_STARTUP=true
DB_REQUIRED_ON_STARTUP=true

# Supabase variables kept for backward compatibility only; not required in Firebase-only mode.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=dmho-certificates
