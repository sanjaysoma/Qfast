    "expo-location": "~17.0.1",
    "expo-notifications": "~0.28.19",
    "expo-status-bar": "~1.12.0",
    "expo-system-ui": "~3.0.7",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-webview": "13.8.6"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "babel-preset-expo": "~11.0.0"
  },
  "private": true
}

